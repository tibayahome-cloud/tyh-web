{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": "./src",
    "types": ["vite/client", "vitest", "@testing-library/jest-dom"]
  },
  // vite.config.ts and playwright.config.ts belong to the composite tsconfig.node.json.
  // Listing them here too made them both an input of this project and an output of that
  // one, which is TS6305 and made a plain `tsc --noEmit` unusable.
  "include": ["src", "tailwind.config.js", "postcss.config.js", "tests"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
